{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply flixlyra-db --remote --config wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint --disable-nested-config app components db lib tests proxy.ts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "security:test": "node --conditions=react-server --experimental-strip-types --test tests/security.test.ts",
    "security:integration": "npm run build && node --loader ./tests/cloudflare-loader.mjs --test tests/worker-security.integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1129.0",
    "@aws-sdk/lib-storage": "3.1129.0",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/workers-types": "5.20260903.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.128.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module"
}
